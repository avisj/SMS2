# ========================================================================
# School Management System SaaS - Environment Configuration
# ========================================================================

NODE_ENV=development
PORT=4000

# JWT Security
JWT_SECRET=super-secret-production-sms-saas-key-replace-in-prod

# Database Connection (Supabase PostgreSQL or standard PostgreSQL)
# If left empty, the application runs on its embedded portable engine for offline testing
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Platform Keys (for Auth & Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Frontend Web Origin for CORS
CORS_ORIGIN=http://localhost:5173
