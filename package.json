{
  "name": "sms2",
  "version": "1.0.0",
  "private": true,
  "description": "SMS2 - Production-oriented multi-tenant School Management System SaaS",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=packages/backend run dev",
    "dev:frontend": "npm --workspace=packages/frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --workspace=packages/backend run build",
    "build:frontend": "npm --workspace=packages/frontend run build",
    "test": "npm run test:backend",
    "test:backend": "npm --workspace=packages/backend run test",
    "db:migrate": "npm --workspace=packages/backend run db:migrate",
    "db:seed": "npm --workspace=packages/backend run db:seed"
  },
  "keywords": [
    "school-management",
    "multi-tenant",
    "saas",
    "typescript",
    "react",
    "nodejs",
    "supabase"
  ],
  "author": "",
  "license": "MIT"
}
